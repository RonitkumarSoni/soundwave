NODE_ENV=development
SERVICE_NAME=monolith
PORT=3000
USE_LOCAL_DB=true
DATABASE_PATH=soundwave-local.db
# Production: set DATABASE_URL, remove USE_LOCAL_DB=true, and supply DATABASE_CA if required.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_CA=your-database-ca-certificate
CORS_ORIGINS=http://localhost:8081
FIREBASE_PROJECT_ID=your-project
# Supply a private service account JSON via this environment variable or the ignored credential file.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
RAZORPAY_KEY_ID=your-regenerated-test-key-id
RAZORPAY_KEY_SECRET=your-regenerated-test-secret
# Test billing is disabled when NODE_ENV=production. Use a separate development backend.
