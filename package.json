{
  "name": "soundwave",
  "main": "index.js",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@types/crypto-js": "^4.2.2",
    "ansi-escapes": "^7.3.0",
    "axios": "^1.18.1",
    "crypto-js": "^4.2.0",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "^54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-av": "^16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.16.0",
    "image-size": "file:vendor/image-size",
    "lottie-react-native": "~7.3.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "3.19.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.4.0",
    "react-native-track-player": "^4.1.2",
    "react-native-web": "~0.21.0",
    "warn-once": "^0.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "build": "expo export -p web",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check:backend": "npm --prefix backend run typecheck && npm --prefix backend test -- --runInBand",
    "test": "node --test tests/*.test.cjs",
    "postinstall": "node scripts/patch-native-compat.cjs"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "postcss": "^8.5.23",
    "xcode": {
      "uuid": "11.1.1"
    },
    "image-size": "$image-size",
    "decode-uri-component": "$decode-uri-component"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player"
        ]
      }
    }
  }
}
