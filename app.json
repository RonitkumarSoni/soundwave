{
  "expo": {
    "name": "soundwave",
    "slug": "soundwave",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/images/soundwave-logo-v2.png",
    "scheme": "soundwave",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/soundwave-logo-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#170B2E"
    },
    "ios": {
      "icon": "./assets/images/soundwave-logo-v2.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#170B2E",
        "foregroundImage": "./assets/images/soundwave-logo-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ronit55.soundwave",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/soundwave-logo-v2.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/soundwave-logo-v2.png",
          "resizeMode": "contain",
          "backgroundColor": "#170B2E"
        }
      ],
      "expo-file-system",
      "expo-av",
      "@react-native-google-signin/google-signin",
      "./plugins/withNoAutofill"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4de77f1-168f-487b-8206-0471b5f1c0c4"
      }
    }
  }
}
